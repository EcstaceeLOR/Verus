{
  "schema_version": "1.0",
  "license": "Apache-2.0",
  "default_branch": "main",
  "merge_method": "squash",
  "private_vulnerability_reporting": true,
  "required_files": [
    "LICENSE",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md",
    "SUPPORT.md",
    ".github/CODEOWNERS",
    ".github/branch-protection.json",
    ".github/GOVERNANCE.md",
    ".github/PULL_REQUEST_TEMPLATE.md",
    ".github/ISSUE_TEMPLATE/config.yml",
    ".github/ISSUE_TEMPLATE/bug_report.yml",
    ".github/ISSUE_TEMPLATE/feature_request.yml"
  ],
  "sensitive_paths": [
    "/.github/",
    "/contracts/",
    "/docs/architecture/",
    "/docs/security/",
    "/deploy/",
    "/SECURITY.md"
  ],
  "required_pr_sections": [
    "## Outcome",
    "## Changes",
    "## Verification",
    "## Risk and operations",
    "## Checklist"
  ]
}
