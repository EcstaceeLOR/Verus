VERUS_ENV=development
VERUS_API_HOST=127.0.0.1
VERUS_API_PORT=3001
VERUS_CONSOLE_PORT=3000
POSTGRES_DB=verus
POSTGRES_USER=verus
POSTGRES_PASSWORD=verus-local-only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://verus:verus-local-only@127.0.0.1:5432/verus
# Trusted scan worker. Use one workspace and policy per worker deployment. The directory must be
# absolute and hold sealed private signing keys; provide a unique 32-byte base64url key outside git.
# VERUS_WORKER_WORKSPACE_ID=
# VERUS_WORKER_POLICY_ID=
# VERUS_WORKER_RULESET_JSON={"schemaVersion":"1.0","version":"local","rules":[]}
# VERUS_WORKER_SECRETS_DIRECTORY=C:\\verus\\secrets
# VERUS_WORKER_SEALING_MASTER_KEY=
# VERUS_WORKER_ID=trusted-worker-local
# Optional: enables authenticated GET /v1/scans read endpoints. Generate a 32-byte value and
# encode it as unpadded base64url; never commit a real production value.
# VERUS_API_KEY_PEPPER=
# VERUS_PUBLIC_API_KEY_LIMIT=120
# VERUS_PUBLIC_API_WORKSPACE_LIMIT=600
# VERUS_PUBLIC_API_WINDOW_SECONDS=60
MINIO_ROOT_USER=verus-local
MINIO_ROOT_PASSWORD=verus-local-only-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
OBJECT_STORE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORE_BUCKET=verus-local
